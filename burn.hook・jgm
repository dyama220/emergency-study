<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>救急現場・ポテンシャル診断</title>
    <style>
        /* アメコミ風・サイバーポップなスタイル設計 */
        :root {
            --primary: #6c5ce7;
            --accent: #ff7675;
            --dark: #2d3436;
            --light: #f5f6fa;
            --border: 4px solid #000;
        }

        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            background-color: #dfe6e9;
            color: var(--dark);
            margin: 0;
            padding: 16px;
            display: flex;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 480px;
            background: #fff;
            border: var(--border);
            box-shadow: 8px 8px 0px #000;
            border-radius: 12px;
            overflow: hidden;
            padding: 20px;
            box-sizing: border-box;
        }

        h1 {
            font-size: 1.4rem;
            background: var(--accent);
            color: #fff;
            margin: -20px -20px 20px -20px;
            padding: 15px;
            text-align: center;
            border-bottom: var(--border);
            text-shadow: 2px 2px 0px #000;
        }

        /* コミック風コマ & キャラクター吹き出し */
        .comic-box {
            background: var(--light);
            border: 3px solid #000;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            position: relative;
        }

        .character-title {
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 5px;
            font-size: 0.9rem;
        }

        .scenario-text {
            font-size: 0.95rem;
            line-height: 1.5;
        }

        /* 入力エリア */
        .input-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
        }

        textarea {
            width: 100%;
            height: 120px;
            border: 3px solid #000;
            border-radius: 6px;
            padding: 10px;
            font-size: 1rem;
            box-sizing: border-box;
            resize: vertical;
        }

        .btn-row {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

        button {
            flex: 1;
            background: var(--primary);
            color: #fff;
            border: 3px solid #000;
            border-radius: 6px;
            padding: 12px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            box-shadow: 4px 4px 0px #000;
            transition: transform 0.1s, box-shadow 0.1s;
        }

        button:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px #000;
        }

        button.mic-btn {
            background: #00b894;
        }

        button.mic-btn.recording {
            background: #d63031;
            animation: pulse 1s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.6; }
            100% { opacity: 1; }
        }

        /* 結果画面（初期非表示） */
        .result-section {
            display: none;
        }

        .cheer-box {
            background: #ffeaa7;
            border: 3px solid #000;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .skill-tag {
            background: #fab1a0;
            border: 2px solid #000;
            padding: 6px 10px;
            border-radius: 4px;
            margin-bottom: 8px;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .cta-btn {
            background: #e17055;
            color: #fff;
            width: 100%;
            text-align: center;
            font-size: 1.1rem;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- STEP 1 & 2: 入力画面 -->
    <div id="input-view">
        <h1>🔥 熱傷救急 現場判断チャレンジ</h1>
        
        <div class="comic-box">
            <div class="character-title">💬 指導救命士からの想定指令</div>
            <div class="scenario-text">
                「住宅火災から救出された40代男性だ。<br>
                顔に煤、鼻毛焦げ、声はガラガラ。右腕の腹側は白く乾燥して『痛くない』と言っている。胸と腹には水疱を認める。SpO2は98%だ！<br><br>
                <b>さあ、お前ならどんな評価をして、どう動き、どう病院に伝える！？ 音声またはテキストで報告しろ！</b>」
            </div>
        </div>

        <div class="input-group">
            <label for="reportInput">🎤 実際の活動報告のように発言を入力：</label>
            <div class="btn-row">
                <button type="button" id="micBtn" class="mic-btn" onclick="toggleSpeechRecognition()">🎙️ 音声入力を試す</button>
            </div>
            <textarea id="reportInput" placeholder="例：鼻毛の焦げと嗄声があるので気道熱傷を疑い、高濃度酸素を投与します。また…"></textarea>
        </div>

        <button onclick="submitReport()">🚀 自分の判断をAIに評価してもらう！</button>
    </div>

    <!-- STEP 3: ポジティブフィードバック & 勉強会案内画面 -->
    <div id="result-view" class="result-section">
        <h1>🌟 ポテンシャル診断結果</h1>

        <div class="comic-box">
            <div class="character-title">✨ 隊長からのフィードバック</div>
            <div class="scenario-text" id="aiFeedbackText">
                「素晴らしい着眼点だ！ 現場の状況をここまでスパッと見抜けるのは、日頃の経験とセンスの証だな！<br><br>
                ……だがな！ お前のポテンシャルはこんなもんじゃない。まだ自分でも気づいていない<b>『もう一段階視野が広がる伸びしろ』</b>がこの事例の中に眠っているぞ！」
            </div>
        </div>

        <div class="cheer-box">
            <div class="character-title">🚀 あなたの未来の伸びしろ（未開放スキル）</div>
            <div class="skill-tag">⭐ スキル①：多角的アプローチ（全身の繋がりを捉える力）</div>
            <div class="skill-tag">⭐ スキル②：未来予測の介入（時間経過による変化への備え）</div>
        </div>

        <div class="comic-box" style="background: #fab1a0;">
            <div class="character-title">📢 隊長からの熱いメッセージ</div>
            <div class="scenario-text">
                「ここから先の『さらに一歩進んだ判断のコツ』は、すべて次の勉強会で鮮やかに繋がっていくぞ！ 現場でもっと頼られる救急隊を目指して、一緒にアップデートしようぜ。<br><b>続きは勉強会で待ってるぞ！</b>」
            </div>
        </div>

        <button class="cta-btn" onclick="alert('勉強会エントリーフォームへ移動します！')">📅 勉強会の詳細を見る・参加する</button>
    </div>
</div>

<script>
    // ブラウザの音声認識（Web Speech API）の簡易実装
    let recognition;
    let isRecording = false;

    function toggleSpeechRecognition() {
        const micBtn = document.getElementById('micBtn');
        const reportInput = document.getElementById('reportInput');

        if (!('webkitSpeechRecognition' in window) && !('speechSynthesis' in window)) {
            alert('お使いのブラウザは音声入力に対応していません。テキストで入力してください。');
            return;
        }

        if (!isRecording) {
            recognition = new webkitSpeechRecognition();
            recognition.lang = 'ja-JP';
            recognition.continuous = true;
            recognition.interimResults = true;

            recognition.onstart = function() {
                isRecording = true;
                micBtn.classList.add('recording');
                micBtn.innerText = '🔴 録音中...（もう一度タップで停止）';
            };

            recognition.onresult = function(event) {
                let transcript = '';
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    transcript += event.results[i][0].transcript;
                }
                reportInput.value = transcript;
            };

            recognition.onerror = function() {
                stopRecognition();
            };

            recognition.onend = function() {
                stopRecognition();
            };

            recognition.start();
        } else {
            stopRecognition();
        }
    }

    function stopRecognition() {
        if (recognition) {
            recognition.stop();
        }
        isRecording = false;
        const micBtn = document.getElementById('micBtn');
        if (micBtn) {
            micBtn.classList.remove('recording');
            micBtn.innerText = '🎙️ 音声入力を試す';
        }
    }

    function submitReport() {
        const text = document.getElementById('reportInput').value.trim();
        if (!text) {
            alert('まずはあなたの活動判断を入力（または音声入力）してください！');
            return;
        }

        // 画面を切り替え（本来はここでGAS経由でGemini APIを叩き、返答を受け取ります）
        document.getElementById('input-view').style.display = 'none';
        document.getElementById('result-view').style.display = 'block';
    }
</script>

</body>
</html>
